{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git remote -v)",
      "Bash(git status:*)",
      "Bash(git branch:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-remote:*)",
      "Bash(git check-ignore:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue create:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh repo view:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo edit:*)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(git remote remove:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npx create-:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh repo delete:*)",
      "Bash(shopify app deploy:*)",
      "Bash(shopify app release:*)",
      "Bash(npx shopify app deploy:*)",
      "Bash(npx shopify app release:*)",
      "Bash(sudo systemctl restart:*)",
      "Bash(systemctl restart:*)",
      "Bash(sudo systemctl start:*)",
      "Bash(systemctl start:*)",
      "Bash(sudo systemctl stop:*)",
      "Bash(systemctl stop:*)",
      "Bash(sudo systemctl enable:*)",
      "Bash(systemctl enable:*)",
      "Bash(sudo systemctl disable:*)",
      "Bash(systemctl disable:*)",
      "Bash(sudo systemctl daemon-reload:*)",
      "Bash(systemctl daemon-reload:*)",
      "Bash(nginx -s:*)",
      "Bash(sudo nginx:*)",
      "Bash(certbot:*)",
      "Bash(pm2 start:*)",
      "Bash(pm2 restart:*)",
      "Bash(pm2 stop:*)",
      "Bash(pm2 delete:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
