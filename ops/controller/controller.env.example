# SCA task controller configuration — EXAMPLE. Names only, no values.
#
# The real file lives at /opt/sca-controller/config/controller.env on the VPS.
# It is mode 600, owned by the service account, and is NOT in Git.
# Never commit a filled-in copy of this file.

# --- Repository the controller watches ---
SCA_REPO_URL=
SCA_REPO_SLUG=
SCA_MAIN_BRANCH=

# --- Runtime ---
SCA_CLAUDE_BIN=
SCA_CLAUDE_MODEL=
SCA_MAX_TURNS=

# --- Safety ---
# 0 = dry-run only. Set to 1 ONLY after ChatGPT has audited the dry-run evidence
# and Francis has approved unattended execution.
SCA_ALLOW_LIVE=

# --- Credentials for live mode (set on the VPS, never in Git) ---
# The service account needs its own credentials. Do not reuse another account's.
ANTHROPIC_API_KEY=
GH_TOKEN=
